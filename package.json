{
  "name": "csc-weather-app",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev:staging",
    "dev:staging": "vite --mode staging",
    "dev:production": "vite --mode production",
    "build": "npm run build:staging && npm run build:production",
    "build:staging": "vite build --mode staging --outDir dist/staging",
    "build:production": "vite build --mode production --outDir dist/production",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "npm run preview:staging",
    "preview:staging": "vite preview --mode staging --outDir dist/staging",
    "preview:production": "vite preview --mode production --outDir dist/production",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:watch": "vitest",
    "verify:version-bump": "node scripts/verify-version-bump.mjs",
    "verify:builds": "npm run verify:staging && npm run verify:production",
    "verify:staging": "node scripts/verify-build-hostnames.mjs staging",
    "verify:production": "node scripts/verify-build-hostnames.mjs production"
  },
  "dependencies": {
    "chart.js": "^4.3.0",
    "chartjs-plugin-annotation": "^3.0.1",
    "react": "19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
